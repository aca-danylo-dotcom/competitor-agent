# DeepSeek (извлечение структуры со страниц конкурентов)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Поисковое API для авто-поиска конкурентов
TAVILY_API_KEY=

# База данных (SQLite локально, позже — Postgres/Neon)
DATABASE_URL=sqlite:///./competitor_agent.db

# Веб-панель
WEB_HOST=127.0.0.1
WEB_PORT=8090

# Ключевые запросы для авто-поиска конкурентов (через запятую)
DISCOVERY_QUERIES=AI agent development agency,custom chatbot development agency,розробка чат-ботів на замовлення

# Рынки, за которыми не следим: цены в этих валютах не собираем,
# сайты в этих доменных зонах не берём под наблюдение
IGNORED_CURRENCIES=RUB
IGNORED_DOMAIN_ZONES=.ru,.рф,.by,.su

# Лимит ручных запусков поиска в день (защита от перерасхода Search API)
DISCOVERY_MANUAL_DAILY_LIMIT=5

# Сколько дней акция может не попадаться на сайте, прежде чем считаем её снятой
PROMOTION_STALE_DAYS=7

# Сколько единиц валюты дают за доллар (для сравнения цен между конкурентами)
USD_RATES=UAH=41.5,EUR=0.92,GBP=0.79,PLN=3.65
